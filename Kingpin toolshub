<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexusMath | All-in-One STEM Study Hub</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- KaTeX for Crisp Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <!-- Tone.js for Pomodoro Audio Alerts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        /* Theme Variables */
        :root {
            --bg-main: #0f172a;
            --bg-surface: #1e293b;
            --bg-elevated: #334155;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent: #38bdf8;
            --accent-hover: #0284c7;
            --border-color: #334155;
            --base-font-size: 16px;
        }

        [data-theme="light"] {
            --bg-main: #f8fafc;
            --bg-surface: #ffffff;
            --bg-elevated: #f1f5f9;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --border-color: #e2e8f0;
        }

        [data-theme="midnight"] {
            --bg-main: #050814;
            --bg-surface: #0b1126;
            --bg-elevated: #151e3f;
            --text-primary: #e2e8f0;
            --text-secondary: #7dd3fc;
            --accent: #818cf8;
            --accent-hover: #6366f1;
            --border-color: #1e293b;
        }

        [data-theme="sepia"] {
            --bg-main: #f4ecd8;
            --bg-surface: #fbf7ed;
            --bg-elevated: #eae0c8;
            --text-primary: #3b3224;
            --text-secondary: #6e5d44;
            --accent: #b45309;
            --accent-hover: #92400e;
            --border-color: #dcd0b4;
        }

        html {
            font-size: var(--base-font-size);
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            transition: background-color 0.25s ease, color 0.25s ease;
        }

        .font-mono-code {
            font-family: 'JetBrains Mono', monospace;
        }

        .bg-main { background-color: var(--bg-main); }
        .bg-surface { background-color: var(--bg-surface); }
        .bg-elevated { background-color: var(--bg-elevated); }
        .text-primary { color: var(--text-primary); }
        .text-secondary { color: var(--text-secondary); }
        .border-theme { border-color: var(--border-color); }
        .accent-bg { background-color: var(--accent); color: #ffffff; }
        .accent-bg:hover { background-color: var(--accent-hover); }
        .accent-text { color: var(--accent); }
        .accent-border { border-color: var(--accent); }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }

        /* Flashcard 3D Flip */
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }

        /* KaTeX scaling adjustment */
        .katex { font-size: 1.15em; }
    </style>
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden selection:bg-sky-500 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-30 bg-surface border-b border-theme px-4 py-3 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
            <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-xl bg-elevated text-primary hover:opacity-80" aria-label="Toggle Menu">
                <i class="ph ph-list text-xl"></i>
            </button>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl accent-bg flex items-center justify-center shadow-md">
                    <i class="ph-bold ph-function text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-tight leading-none">NexusMath</h1>
                    <p class="text-xs text-secondary mt-0.5 hidden sm:block">STEM Study & Formula Hub</p>
                </div>
            </div>
        </div>

        <!-- Center Quick Status Pills -->
        <div class="hidden md:flex items-center gap-3">
            <button onclick="switchMainView('formulas')" id="nav-pill-formulas" class="px-3.5 py-1.5 rounded-xl text-sm font-medium transition accent-bg">
                <i class="ph ph-books mr-1.5"></i>Formulas
            </button>
            <button onclick="switchMainView('flashcards')" id="nav-pill-flashcards" class="px-3.5 py-1.5 rounded-xl text-sm font-medium bg-elevated text-primary hover:opacity-80 transition">
                <i class="ph ph-cards mr-1.5"></i>Flashcards
            </button>
            <button onclick="switchMainView('notes')" id="nav-pill-notes" class="px-3.5 py-1.5 rounded-xl text-sm font-medium bg-elevated text-primary hover:opacity-80 transition">
                <i class="ph ph-notepad mr-1.5"></i>Scratchpad
            </button>
        </div>

        <!-- Right Controls: Mode Badge, Calc Toggle, jsDelivr Runner, Settings -->
        <div class="flex items-center gap-2">
            <button onclick="toggleAngleMode()" id="header-angle-badge" title="Toggle Degrees/Radians" class="px-2.5 py-1.5 rounded-xl bg-elevated border border-theme text-xs font-mono-code font-semibold accent-text hover:opacity-80 transition">
                RAD
            </button>

            <button onclick="toggleRightDrawer()" id="toggle-calc-btn" class="px-3 py-2 rounded-xl bg-elevated border border-theme text-sm font-medium flex items-center gap-1.5 hover:opacity-85 transition" title="Toggle Calculator & Timer">
                <i class="ph ph-calculator text-lg accent-text"></i>
                <span class="hidden sm:inline">Tools</span>
            </button>

            <button onclick="openJsdelivrModal()" id="header-jsdelivr-btn" class="relative px-3 py-2 rounded-xl bg-elevated border border-theme text-sm font-medium flex items-center gap-1.5 hover:opacity-85 transition" title="Open Helper">
                <i class="ph ph-browser text-lg accent-text"></i>
                <span class="hidden sm:inline">Helper</span>
            </button>

            <button onclick="openSettingsModal()" class="p-2 rounded-xl bg-elevated border border-theme text-primary hover:opacity-85 transition" title="Settings" aria-label="Settings">
                <i class="ph ph-gear text-xl"></i>
            </button>
        </div>
    </header>

    <!-- Main 3-Column Workspace -->
    <div class="flex-1 flex relative overflow-hidden">

        <!-- Left Sidebar: Subjects & Quick Sheet -->
        <aside id="left-sidebar" class="fixed lg:static inset-y-0 left-0 z-20 w-64 bg-surface border-r border-theme transform -translate-x-full lg:translate-x-0 transition-transform duration-200 flex flex-col pt-16 lg:pt-0">
            <div class="p-4 flex-1 overflow-y-auto space-y-6">
                <!-- Mobile Nav Views -->
                <div class="md:hidden space-y-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-secondary px-2 mb-2">Workspace</p>
                    <button onclick="switchMainView('formulas'); closeMobileMenu();" class="w-full text-left px-3 py-2 rounded-xl text-sm font-medium bg-elevated flex items-center gap-2">
                        <i class="ph ph-books accent-text"></i> Formula Hub
                    </button>
                    <button onclick="switchMainView('flashcards'); closeMobileMenu();" class="w-full text-left px-3 py-2 rounded-xl text-sm font-medium hover:bg-elevated flex items-center gap-2">
                        <i class="ph ph-cards accent-text"></i> Flashcard Quiz
                    </button>
                    <button onclick="switchMainView('notes'); closeMobileMenu();" class="w-full text-left px-3 py-2 rounded-xl text-sm font-medium hover:bg-elevated flex items-center gap-2">
                        <i class="ph ph-notepad accent-text"></i> Study Scratchpad
                    </button>
                </div>

                <!-- Pinned Quick Sheet -->
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-secondary px-2 mb-2">Exam Prep</p>
                    <button onclick="selectCategory('pinned')" id="cat-btn-pinned" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-elevated">
                        <span class="flex items-center gap-2.5">
                            <i class="ph-fill ph-push-pin text-amber-400"></i>
                            <span>Pinned Quick Sheet</span>
                        </span>
                        <span id="pinned-count-badge" class="text-xs px-2 py-0.5 rounded-full bg-elevated font-mono-code">0</span>
                    </button>
                </div>

                <!-- Math Disciplines -->
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-secondary px-2 mb-2">Subjects</p>
                    <nav class="space-y-1" id="category-nav">
                        <button onclick="selectCategory('all')" id="cat-btn-all" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium accent-bg transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-squares-four"></i> All Formulas</span>
                        </button>
                        <button onclick="selectCategory('Algebra')" id="cat-btn-Algebra" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-elevated transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-x-square"></i> Algebra 1 & 2</span>
                        </button>
                        <button onclick="selectCategory('Geometry')" id="cat-btn-Geometry" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-elevated transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-triangle"></i> Geometry</span>
                        </button>
                        <button onclick="selectCategory('Trigonometry')" id="cat-btn-Trigonometry" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-elevated transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-wave-sine"></i> Trigonometry</span>
                        </button>
                        <button onclick="selectCategory('Pre-Calculus')" id="cat-btn-Pre-Calculus" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-elevated transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-chart-line-up"></i> Pre-Calculus</span>
                        </button>
                        <button onclick="selectCategory('Calculus')" id="cat-btn-Calculus" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-elevated transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-infinity"></i> Calculus</span>
                        </button>
                        <button onclick="selectCategory('Statistics')" id="cat-btn-Statistics" class="category-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-elevated transition">
                            <span class="flex items-center gap-2.5"><i class="ph ph-chart-bar"></i> Statistics</span>
                        </button>
                    </nav>
                </div>
            </div>

            <!-- Mini Pomodoro Widget in Left Sidebar Footer -->
            <div class="p-4 border-t border-theme bg-elevated/40">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs font-semibold uppercase tracking-wider text-secondary flex items-center gap-1">
                        <i class="ph ph-timer accent-text"></i> Focus Timer
                    </span>
                    <span id="sidebar-pomo-status" class="text-[11px] px-2 py-0.5 rounded-full bg-surface text-secondary">Study</span>
                </div>
                <div class="flex items-center justify-between">
                    <span id="sidebar-pomo-display" class="font-mono-code text-xl font-bold">25:00</span>
                    <div class="flex gap-1">
                        <button onclick="togglePomodoro()" id="sidebar-pomo-btn" class="p-2 rounded-lg accent-bg text-xs" title="Start/Pause">
                            <i class="ph-fill ph-play"></i>
                        </button>
                        <button onclick="resetPomodoro()" class="p-2 rounded-lg bg-surface border border-theme text-xs hover:opacity-80" title="Reset">
                            <i class="ph ph-arrow-counter-clockwise"></i>
                        </button>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Center Main Content Area -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto w-full">

            <!-- VIEW 1: FORMULA REFERENCE HUB -->
            <section id="view-formulas" class="space-y-6">
                <!-- Header & Search Bar -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 id="current-category-title" class="text-2xl font-bold tracking-tight">All STEM Formulas</h2>
                        <p id="current-category-subtitle" class="text-sm text-secondary mt-0.5">Browse, search, and pin essential formulas for quick exam review.</p>
                    </div>
                    <div class="relative w-full sm:w-72">
                        <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary"></i>
                        <input type="text" id="formula-search" placeholder="Search quadratic, derivative, sine..." 
                            class="w-full pl-10 pr-9 py-2.5 rounded-xl bg-surface border border-theme text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 transition">
                        <button id="clear-search-btn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-secondary hover:text-primary">
                            <i class="ph-fill ph-x-circle"></i>
                        </button>
                    </div>
                </div>

                <!-- Formula Cards Grid -->
                <div id="formulas-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Populated via JS -->
                </div>

                <!-- Empty State -->
                <div id="empty-formulas-state" class="hidden text-center py-16 bg-surface rounded-2xl border border-theme">
                    <i class="ph ph-magnifying-glass text-4xl text-secondary mb-3"></i>
                    <h3 class="text-lg font-semibold">No formulas found</h3>
                    <p class="text-sm text-secondary mt-1 max-w-md mx-auto">Try adjusting your search keywords or switch to another subject category.</p>
                    <button onclick="selectCategory('all'); clearSearch();" class="mt-4 px-4 py-2 rounded-xl accent-bg text-sm font-medium">
                        Reset Filters
                    </button>
                </div>
            </section>

            <!-- VIEW 2: FLASHCARD / QUIZ MODE -->
            <section id="view-flashcards" class="hidden space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight">Formula Flashcards</h2>
                        <p class="text-sm text-secondary mt-0.5">Test your recall before exams. Click the card to reveal the formula.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <select id="flashcard-deck-select" onchange="initFlashcards()" class="px-3.5 py-2 rounded-xl bg-surface border border-theme text-sm focus:outline-none">
                            <option value="all">All Subjects</option>
                            <option value="pinned">Pinned Quick Sheet Only</option>
                            <option value="Algebra">Algebra 1 & 2</option>
                            <option value="Geometry">Geometry</option>
                            <option value="Trigonometry">Trigonometry</option>
                            <option value="Pre-Calculus">Pre-Calculus</option>
                            <option value="Calculus">Calculus</option>
                            <option value="Statistics">Statistics</option>
                        </select>
                        <button onclick="shuffleFlashcards()" class="p-2.5 rounded-xl bg-surface border border-theme hover:bg-elevated transition" title="Shuffle Deck">
                            <i class="ph ph-shuffle text-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="bg-surface p-4 rounded-2xl border border-theme flex items-center justify-between gap-4">
                    <span id="flashcard-counter" class="text-sm font-mono-code font-semibold">Card 1 of 10</span>
                    <div class="flex-1 h-2 bg-elevated rounded-full overflow-hidden">
                        <div id="flashcard-progress" class="h-full accent-bg transition-all duration-300" style="width: 10%"></div>
                    </div>
                    <span id="flashcard-mastered" class="text-xs text-emerald-400 font-medium">Mastered: 0</span>
                </div>

                <!-- 3D Flip Card -->
                <div class="perspective-1000 w-full max-w-2xl mx-auto h-80 cursor-pointer" onclick="flipFlashcard()">
                    <div id="flashcard-inner" class="relative w-full h-full transition-transform duration-500 transform-style-3d">
                        <!-- Front -->
                        <div class="absolute inset-0 backface-hidden bg-surface border-2 border-theme rounded-3xl p-8 flex flex-col items-center justify-center text-center shadow-lg">
                            <span id="fc-front-badge" class="px-3 py-1 rounded-full bg-elevated text-xs font-semibold accent-text mb-4">Algebra</span>
                            <h3 id="fc-front-title" class="text-2xl sm:text-3xl font-bold mb-3">Quadratic Formula</h3>
                            <p id="fc-front-hint" class="text-sm text-secondary max-w-md">Finds the roots of a standard quadratic equation ax² + bx + c = 0.</p>
                            <span class="mt-8 text-xs text-secondary flex items-center gap-1.5">
                                <i class="ph ph-hand-tap"></i> Click card to flip
                            </span>
                        </div>
                        <!-- Back -->
                        <div class="absolute inset-0 backface-hidden rotate-y-180 bg-surface border-2 accent-border rounded-3xl p-8 flex flex-col items-center justify-center text-center shadow-lg">
                            <span class="text-xs uppercase tracking-wider text-secondary mb-3">Formula & Notes</span>
                            <div id="fc-back-math" class="text-xl sm:text-2xl py-4 px-6 rounded-2xl bg-elevated/60 border border-theme my-2 overflow-x-auto max-w-full">
                                <!-- KaTeX rendered -->
                            </div>
                            <p id="fc-back-desc" class="text-xs sm:text-sm text-secondary mt-3 max-w-md"></p>
                        </div>
                    </div>
                </div>

                <!-- Flashcard Controls -->
                <div class="flex items-center justify-center gap-3 max-w-2xl mx-auto">
                    <button onclick="prevFlashcard()" class="px-4 py-2.5 rounded-xl bg-surface border border-theme text-sm font-medium hover:bg-elevated transition flex items-center gap-1.5">
                        <i class="ph ph-arrow-left"></i> Previous
                    </button>
                    <button onclick="markFlashcardMastered()" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium transition flex items-center gap-1.5 shadow-sm">
                        <i class="ph-bold ph-check"></i> Got It!
                    </button>
                    <button onclick="nextFlashcard()" class="px-4 py-2.5 rounded-xl bg-surface border border-theme text-sm font-medium hover:bg-elevated transition flex items-center gap-1.5">
                        Next <i class="ph ph-arrow-right"></i>
                    </button>
                </div>
            </section>

            <!-- VIEW 3: STUDY SCRATCHPAD / NOTES -->
            <section id="view-notes" class="hidden space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight">Study Scratchpad</h2>
                        <p class="text-sm text-secondary mt-0.5">Auto-saved locally in your browser. Great for working out multi-step problems.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span id="notes-save-status" class="text-xs text-secondary flex items-center gap-1">
                            <i class="ph-fill ph-check-circle text-emerald-400"></i> Saved
                        </span>
                        <button onclick="copyNotes()" class="px-3 py-2 rounded-xl bg-surface border border-theme text-xs font-medium hover:bg-elevated transition flex items-center gap-1.5">
                            <i class="ph ph-copy"></i> Copy
                        </button>
                        <button onclick="clearNotes()" class="px-3 py-2 rounded-xl bg-surface border border-theme text-xs font-medium text-rose-400 hover:bg-elevated transition flex items-center gap-1.5">
                            <i class="ph ph-trash"></i> Clear
                        </button>
                    </div>
                </div>

                <!-- Quick Math Symbol Insert Toolbar -->
                <div class="flex flex-wrap items-center gap-1.5 p-2 rounded-xl bg-surface border border-theme">
                    <span class="text-xs text-secondary px-2">Insert Symbol:</span>
                    <button onclick="insertSymbol('π')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">π</button>
                    <button onclick="insertSymbol('θ')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">θ</button>
                    <button onclick="insertSymbol('√()')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">√</button>
                    <button onclick="insertSymbol('∫')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">∫</button>
                    <button onclick="insertSymbol('∑')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">∑</button>
                    <button onclick="insertSymbol('∞')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">∞</button>
                    <button onclick="insertSymbol('≈')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">≈</button>
                    <button onclick="insertSymbol('≠')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">≠</button>
                    <button onclick="insertSymbol('≤')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">≤</button>
                    <button onclick="insertSymbol('≥')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">≥</button>
                    <button onclick="insertSymbol('Δ')" class="px-2.5 py-1 rounded-lg bg-elevated hover:opacity-80 font-mono-code text-sm">Δ</button>
                </div>

                <textarea id="study-scratchpad" rows="16" placeholder="Type your problem steps, definitions, or exam reminders here..." 
                    class="w-full p-5 rounded-2xl bg-surface border border-theme font-mono-code text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-sky-500 resize-y"></textarea>
            </section>

        </main>

        <!-- Right Dockable Panel: Scientific Calculator, Solvers & Pomodoro -->
        <aside id="right-tools-drawer" class="fixed xl:static inset-y-0 right-0 z-20 w-80 sm:w-96 bg-surface border-l border-theme transform translate-x-full xl:translate-x-0 transition-transform duration-200 flex flex-col pt-16 xl:pt-0 shadow-2xl xl:shadow-none">
            
            <!-- Tool Tabs -->
            <div class="flex border-b border-theme p-2 gap-1 bg-elevated/30">
                <button onclick="switchToolTab('calc')" id="tool-tab-calc" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold accent-bg transition flex items-center justify-center gap-1">
                    <i class="ph ph-calculator"></i> Calc
                </button>
                <button onclick="switchToolTab('solvers')" id="tool-tab-solvers" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold hover:bg-elevated transition flex items-center justify-center gap-1">
                    <i class="ph ph-magic-wand"></i> Solvers
                </button>
                <button onclick="switchToolTab('pomodoro')" id="tool-tab-pomodoro" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold hover:bg-elevated transition flex items-center justify-center gap-1">
