        window.convertUnits = function() {
            const cat = document.getElementById('unit-category').value;
            const val = parseFloat(document.getElementById('unit-input').value);
            const fromU = document.getElementById('unit-from').value;
            const toU = document.getElementById('unit-to').value;
            const out = document.getElementById('unit-output');

            if (isNaN(val)) {
                out.textContent = '—';
                return;
            }
            const base = UNIT_DATA[cat].toBase[fromU](val);
            const res = UNIT_DATA[cat].fromBase[toU](base);
            out.textContent = Number(res.toPrecision(6));
        };

        // ==========================================
        // 8. FLASHCARD QUIZ MODE
        // ==========================================
        window.initFlashcards = function() {
            const deckType = document.getElementById('flashcard-deck-select').value;
            let cards = FORMULAS_DB.filter(f => {
                if (deckType === 'all') return true;
                if (deckType === 'pinned') return state.pinnedIds.includes(f.id);
                return f.category === deckType;
            });
            if (cards.length === 0) cards = [...FORMULAS_DB];
            state.fcDeck = [...cards];
            state.fcIndex = 0;
            state.fcFlipped = false;
            state.fcMastered.clear();
            renderFlashcard();
        };

        window.shuffleFlashcards = function() {
            for (let i = state.fcDeck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [state.fcDeck[i], state.fcDeck[j]] = [state.fcDeck[j], state.fcDeck[i]];
            }
            state.fcIndex = 0;
            state.fcFlipped = false;
            renderFlashcard();
            showToast('Deck shuffled');
        };

        function renderFlashcard() {
            const card = state.fcDeck[state.fcIndex];
            if (!card) return;
            document.getElementById('flashcard-inner').classList.toggle('rotate-y-180', state.fcFlipped);
            document.getElementById('fc-front-badge').textContent = card.category;
            document.getElementById('fc-front-title').textContent = card.title;
            document.getElementById('fc-front-hint').textContent = card.desc;
            document.getElementById('fc-back-desc').textContent = card.desc;

            const mathEl = document.getElementById('fc-back-math');
            mathEl.setAttribute('data-latex', card.latex);
            mathEl.classList.add('katex-render');
            renderAllKatex();

            const total = state.fcDeck.length;
            document.getElementById('flashcard-counter').textContent = `Card ${state.fcIndex + 1} of ${total}`;
            document.getElementById('flashcard-progress').style.width = `${((state.fcIndex + 1) / total) * 100}%`;
            document.getElementById('flashcard-mastered').textContent = `Mastered: ${state.fcMastered.size}`;
        }

        window.flipFlashcard = function() {
            state.fcFlipped = !state.fcFlipped;
            document.getElementById('flashcard-inner').classList.toggle('rotate-y-180', state.fcFlipped);
        };

        window.nextFlashcard = function() {
            state.fcFlipped = false;
            state.fcIndex = (state.fcIndex + 1) % state.fcDeck.length;
            renderFlashcard();
        };

        window.prevFlashcard = function() {
            state.fcFlipped = false;
            state.fcIndex = (state.fcIndex - 1 + state.fcDeck.length) % state.fcDeck.length;
            renderFlashcard();
        };

        window.markFlashcardMastered = function() {
            const card = state.fcDeck[state.fcIndex];
            if (card) state.fcMastered.add(card.id);
            nextFlashcard();
        };

        // ==========================================
        // 9. STUDY SCRATCHPAD
        // ==========================================
        window.insertSymbol = function(sym) {
            const pad = document.getElementById('study-scratchpad');
            const start = pad.selectionStart;
            const end = pad.selectionEnd;
            pad.value = pad.value.substring(0, start) + sym + pad.value.substring(end);
            pad.focus();
            pad.selectionStart = pad.selectionEnd = start + sym.length;
            state.notes = pad.value;
            localStorage.setItem('nexus_notes', state.notes);
        };

        window.copyNotes = function() {
            const text = document.getElementById('study-scratchpad').value;
            copyTextToClipboard(text);
            showToast('Scratchpad copied to clipboard');
        };

        window.clearNotes = function() {
            document.getElementById('study-scratchpad').value = '';
            state.notes = '';
            localStorage.setItem('nexus_notes', '');
            showToast('Scratchpad cleared');
        };

        // ==========================================
        // 10. POMODORO FOCUS TIMER
        // ==========================================
        window.togglePomodoro = function() {
            if (state.pomoRunning) {
                clearInterval(state.pomoInterval);
                state.pomoRunning = false;
            } else {
                state.pomoRunning = true;
                state.pomoInterval = setInterval(() => {
                    if (state.pomoRemaining > 0) {
                        state.pomoRemaining--;
                        updatePomodoroDisplays();
                    } else {
                        clearInterval(state.pomoInterval);
                        state.pomoRunning = false;
                        playTimerChime();
                        if (state.pomoPhase === 'study') {
                            state.pomoSessions++;
                            document.getElementById('pomo-sessions-count').textContent = state.pomoSessions;
                            setPomodoroPhase('short');
                            showToast('Focus session complete! Time for a break.');
                        } else {
                            setPomodoroPhase('study');
                            showToast('Break finished! Ready to focus.');
                        }
                    }
                }, 1000);
            }
            updatePomodoroDisplays();
        };

        window.resetPomodoro = function() {
            clearInterval(state.pomoInterval);
            state.pomoRunning = false;
            state.pomoRemaining = state.pomoDurations[state.pomoPhase];
            updatePomodoroDisplays();
        };

        window.setPomodoroPhase = function(phase) {
            clearInterval(state.pomoInterval);
            state.pomoRunning = false;
            state.pomoPhase = phase;
            state.pomoRemaining = state.pomoDurations[phase];

            ['study', 'short', 'long'].forEach(p => {
                const btn = document.getElementById(`pomo-phase-${p}`);
                if (p === phase) {
                    btn.classList.add('accent-bg');
                    btn.classList.remove('text-secondary');
                } else {
                    btn.classList.remove('accent-bg');
                    btn.classList.add('text-secondary');
                }
            });

            const labels = { study: 'Study', short: 'Short Break', long: 'Long Break' };
            document.getElementById('sidebar-pomo-status').textContent = labels[phase];
            updatePomodoroDisplays();
        };

        window.updatePomoDurations = function() {
            const s = Math.max(1, parseInt(document.getElementById('pomo-study-min').value || '25', 10));
            const sh = Math.max(1, parseInt(document.getElementById('pomo-short-min').value || '5', 10));
            const l = Math.max(1, parseInt(document.getElementById('pomo-long-min').value || '15', 10));
            state.pomoDurations = { study: s * 60, short: sh * 60, long: l * 60 };
            if (!state.pomoRunning) {
                state.pomoRemaining = state.pomoDurations[state.pomoPhase];
                updatePomodoroDisplays();
            }
        };

        function updatePomodoroDisplays() {
            const mins = String(Math.floor(state.pomoRemaining / 60)).padStart(2, '0');
            const secs = String(state.pomoRemaining % 60).padStart(2, '0');
            const formatted = `${mins}:${secs}`;
            document.getElementById('sidebar-pomo-display').textContent = formatted;
            document.getElementById('main-pomo-display').textContent = formatted;

            const iconHtml = state.pomoRunning ? '<i class="ph-fill ph-pause"></i>' : '<i class="ph-fill ph-play"></i>';
            document.getElementById('sidebar-pomo-btn').innerHTML = iconHtml;
            document.getElementById('main-pomo-btn').innerHTML = `${iconHtml} ${state.pomoRunning ? 'Pause' : 'Start'}`;
        }

        function playTimerChime() {
            try {
                if (typeof Tone !== 'undefined') {
                    const synth = new Tone.Synth().toDestination();
                    synth.triggerAttackRelease('C5', '8n');
                    setTimeout(() => synth.triggerAttackRelease('G5', '4n'), 180);
                }
            } catch (e) {}
        }

        // ==========================================
        // 11. SETTINGS & UTILITIES
        // ==========================================
        window.openSettingsModal = function() {
            document.getElementById('settings-modal').classList.remove('hidden');
        };

        window.closeSettingsModal = function() {
            document.getElementById('settings-modal').classList.add('hidden');
        };

        window.setTheme = function(theme) {
            state.theme = theme;
            localStorage.setItem('nexus_theme', theme);
            applyTheme(theme);
        };

        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.removeAttribute('data-theme');
            } else {
                document.documentElement.setAttribute('data-theme', theme);
            }
            document.querySelectorAll('.theme-option').forEach(btn => btn.classList.remove('ring-2', 'ring-sky-500'));
            const active = document.getElementById(`theme-btn-${theme}`);
            if (active) active.classList.add('ring-2', 'ring-sky-500');
        }

        window.toggleAngleMode = function() {
            setAngleMode(state.angleMode === 'RAD' ? 'DEG' : 'RAD', true);
        };

        window.setAngleMode = function(mode, notify = true) {
            state.angleMode = mode;
            localStorage.setItem('nexus_angle', mode);
            document.getElementById('header-angle-badge').textContent = mode;
            document.getElementById('calc-mode-indicator').textContent = mode;

            const radBtn = document.getElementById('settings-rad-btn');
            const degBtn = document.getElementById('settings-deg-btn');
            if (mode === 'RAD') {
                radBtn.classList.add('accent-bg');
                radBtn.classList.remove('text-secondary');
                degBtn.classList.remove('accent-bg');
                degBtn.classList.add('text-secondary');
            } else {
                degBtn.classList.add('accent-bg');
                degBtn.classList.remove('text-secondary');
                radBtn.classList.remove('accent-bg');
                radBtn.classList.add('text-secondary');
            }
            if (notify) showToast(`Angle mode set to ${mode}`);
        };

        window.setPrecision = function(val) {
            state.precision = val;
            localStorage.setItem('nexus_precision', val);
        };

        window.setFontSize = function(px, save = true) {
            state.fontSize = parseInt(px, 10);
            document.documentElement.style.setProperty('--base-font-size', `${state.fontSize}px`);
            document.getElementById('settings-font-size').value = state.fontSize;
            const pct = Math.round((state.fontSize / 16) * 100);
            document.getElementById('font-size-label').textContent = `${pct}% (${state.fontSize}px)`;
            if (save) localStorage.setItem('nexus_fontsize', state.fontSize);
        };

        window.resetAllUserData = function() {
            localStorage.removeItem('nexus_pinned');
            localStorage.removeItem('nexus_notes');
            state.pinnedIds = [];
            state.notes = '';
            document.getElementById('study-scratchpad').value = '';
            updatePinnedBadge();
            renderFormulas();
            closeSettingsModal();
            showToast('Saved bookmarks and notes cleared');
        };

        function copyTextToClipboard(text) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'px-4 py-2.5 rounded-xl bg-surface border border-theme shadow-lg text-xs font-medium flex items-center gap-2 transition-opacity duration-300';
            toast.innerHTML = `<i class="ph-fill ph-info accent-text text-base"></i><span>${msg}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2200);
        }

        // ==========================================
        // 12. FULL-SCREEN JSDELIVR HTML VIEWER
        // ==========================================
        const JSDELIVR_HTML_URL = 'https://cdn.jsdelivr.net/gh/brandstifter-ctrl/AfterspaceMovies@main/Afterspace%20-%20Helper.html';
        let jsdelivrHtmlLoaded = false;

        window.openJsdelivrModal = function() {
            const modal = document.getElementById('jsdelivr-modal');
            if (modal) {
                modal.classList.remove('hidden');
            }
            if (!jsdelivrHtmlLoaded) {
                window.loadJsdelivrHtmlFullscreen(false);
            }
        };

        window.closeJsdelivrModal = function() {
            const modal = document.getElementById('jsdelivr-modal');
            if (modal) {
                modal.classList.add('hidden');
            }
        };

        window.loadJsdelivrHtmlFullscreen = async function(forceReload = false) {
            const loader = document.getElementById('jsdelivr-loading-indicator');
            const iframe = document.getElementById('jsdelivr-html-iframe');
            if (!iframe) return;

            if (jsdelivrHtmlLoaded && !forceReload) return;

            if (loader) loader.classList.remove('hidden');
            try {
                const response = await fetch(JSDELIVR_HTML_URL);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const htmlText = await response.text();

                // Inject <base> tag so relative assets inside the HTML resolve via jsDelivr
                const baseDir = JSDELIVR_HTML_URL.substring(0, JSDELIVR_HTML_URL.lastIndexOf('/') + 1);
                const baseTag = `<base href="${baseDir}">`;
                const finalHtml = /<head[^>]*>/i.test(htmlText)
                    ? htmlText.replace(/<head[^>]*>/i, match => `${match}\n${baseTag}`)
                    : `${baseTag}\n${htmlText}`;

                iframe.srcdoc = finalHtml;
                jsdelivrHtmlLoaded = true;
            } catch (err) {
                iframe.srcdoc = `<div style="font-family:sans-serif;padding:2rem;color:#ef4444;">Failed to load HTML from jsDelivr: ${err.message}</div>`;
            } finally {
                if (loader) loader.classList.add('hidden');
            }
        };
    </script>
</body>
