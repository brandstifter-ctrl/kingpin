        }

        function factorial(n) {
            if (n < 0 || !Number.isInteger(n)) return NaN;
            if (n > 170) return Infinity;
            let res = 1;
            for (let i = 2; i <= n; i++) res *= i;
            return res;
        }

        window.calcEvaluate = function() {
            if (!state.calcExpr) return;
            const raw = state.calcExpr;
            try {
                // Balance unclosed parentheses automatically
                const openCount = (raw.match(/\(/g) || []).length;
                const closeCount = (raw.match(/\)/g) || []).length;
                let expr = raw + ')'.repeat(Math.max(0, openCount - closeCount));

                const toRad = (x) => state.angleMode === 'DEG' ? (x * Math.PI / 180) : x;
                const fromRad = (x) => state.angleMode === 'DEG' ? (x * 180 / Math.PI) : x;

                const scope = {
                    sin: (x) => Math.sin(toRad(x)),
                    cos: (x) => Math.cos(toRad(x)),
                    tan: (x) => Math.tan(toRad(x)),
                    asin: (x) => fromRad(Math.asin(x)),
                    acos: (x) => fromRad(Math.acos(x)),
                    atan: (x) => fromRad(Math.atan(x)),
                    ln: Math.log,
                    log: Math.log10,
                    sqrt: Math.sqrt,
                    fact: factorial
                };

                // Transform expression safely for evaluation
                let parsed = expr
                    .replace(/π/g, `(${Math.PI})`)
                    .replace(/\be\b/g, `(${Math.E})`)
                    .replace(/(\d+(?:\.\d+)?|\))!/g, 'fact($1)')
                    .replace(/\^/g, '**');

                const fn = new Function('scope', `with(scope){ return (${parsed}); }`);
                const result = fn(scope);

                if (typeof result !== 'number' || Number.isNaN(result)) {
                    throw new Error('Math Error');
                }

                const formatted = formatCalcResult(result);
                state.calcLastAns = Number(formatted);
                document.getElementById('calc-expression').textContent = raw + ' =';
                document.getElementById('calc-display').textContent = formatted;
                state.calcExpr = String(formatted);

                state.calcHistory.unshift({ expr: raw, res: formatted });
                if (state.calcHistory.length > 25) state.calcHistory.pop();
                renderCalcHistory();
            } catch (err) {
                document.getElementById('calc-expression').textContent = raw;
                document.getElementById('calc-display').textContent = 'Error';
                state.calcExpr = '';
            }
        };

        function formatCalcResult(num) {
            if (!Number.isFinite(num)) return String(num);
            if (Math.abs(num) < 1e-12) return '0';
            if (state.precision === 'full') return String(Number(num.toPrecision(12)));
            const dec = parseInt(state.precision, 10);
            return String(Number(num.toFixed(dec)));
        }

        function renderCalcHistory() {
            const list = document.getElementById('calc-history-list');
            if (state.calcHistory.length === 0) {
